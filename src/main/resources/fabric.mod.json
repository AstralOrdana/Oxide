{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.gif",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ordana.oxide.fabric.OxideFabric"
    ],
    "rrv": [
      "com.ordana.oxide.integrations.RrvIntegration"
    ],
    "fabric-datagen": [
      "com.ordana.oxide.fabric.data.OxideDataGenerator"
    ]
  },
  "mixins": [
    "oxide.mixins.json"
  ],
  "depends": {
    "fabricloader": ">0.18.0",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "moonlight": ">=26.1.2-4.0.2"
  }
}